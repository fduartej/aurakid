# Qdrant (clúster existente: conocimiento_operacion)
QDRANT_URL=https://ee37ef27-05ea-46f4-9506-e146763f9221.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=conocimiento_operacion

# Embeddings (deben coincidir con los usados al crear la colección existente)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# LLM (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Nota: "Organization" y el "BaseUrl" (.../openai/v1) del backend .NET son propios del
# cliente OpenAI-compatible; esta app usa el SDK nativo de Groq (langchain-groq), que
# no requiere ni admite esos campos. No es necesario configurarlos aquí.

# SQLite
SQLITE_PATH=data/chat_history.db

# Administración (protege la página de gestión de documentos)
ADMIN_PASSWORD=

# Ingesta
MAX_UPLOAD_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120
UPSERT_BATCH_SIZE=64

# Recuperación / RAG
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.25
HISTORY_WINDOW_MESSAGES=6
